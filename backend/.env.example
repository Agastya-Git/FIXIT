# FixIt - Backend Environment Configuration Template
# Copy this file to .env and configure your local settings:
# cp .env.example .env

# ── SMTP Email Delivery (Gmail or any SMTP provider) ──────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_STARTTLS=true
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_gmail_app_password
SMTP_FROM_EMAIL=FixIt Campus Support <your_email@gmail.com>

# ── App Configuration ──────────────────────────────────────────────────────────
APP_BASE_URL=http://localhost:5175
PUBLIC_REGISTRATION_ENABLED=true
SEED_DEMO_DATA=false

# ── Database ───────────────────────────────────────────────────────────────────
MONGODB_URI=mongodb://localhost:27017
DB_NAME=fixit_db
